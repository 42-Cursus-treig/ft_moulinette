MOULINETTE_42_CLIENT_ID=
MOULINETTE_42_CLIENT_SECRET=
MOULINETTE_42_REDIRECT_URL=
# Optionnel : base de l'API 42 (défaut https://api.intra.42.fr).
# Utile en dev pour pointer vers un mock local.
#MOULINETTE_42_BASE_URL=

# Optionnel : scope OAuth demandé à 42 (défaut "public").
# Pour activer l'agenda des créneaux de correction (/v2/slots), mettre
# "public projects" ET cocher le scope "projects" sur l'application côté
# intra (https://profile.intra.42.fr/oauth/applications). Après changement,
# les utilisateurs doivent se déconnecter/reconnecter.
#MOULINETTE_42_SCOPE=public projects
# Optionnel : fichier des dispositions de dashboard par utilisateur
# (défaut data/dashboard_layouts.json).
#MOULINETTE_LAYOUTS_FILE=
