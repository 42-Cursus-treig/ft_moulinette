# ── OAuth 42 ────────────────────────────────────────────────────────────────
# Application créée sur https://profile.intra.42.fr/oauth/applications/new
# MÊME application que ft_intra (une seule app 42 pour les deux services).
FT_42_CLIENT_ID=
FT_42_CLIENT_SECRET=
# Redirect URI, doit correspondre exactement à celle déclarée côté 42.
# Défaut : http://localhost:9090/auth/callback
# En prod, le login est délégué à ft_intra : voir FT_MOULINETTE_LOGIN_URL.
#FT_42_REDIRECT_URL=
# Scope OAuth (défaut "public") : suffit au profil et au classement.
#FT_42_SCOPE=public
# Base de l'API 42 (défaut https://api.intra.42.fr). Utile pour un mock local.
#FT_42_BASE_URL=

# ── Serveur ─────────────────────────────────────────────────────────────────
# Adresse d'écoute (défaut :9090 ; :8080 est réservé à ft_intra).
#FT_MOULINETTE_ADDR=:9090
# Logins admin, séparés par des virgules (défaut "treig").
#FT_MOULINETTE_ADMIN_LOGINS=treig
# Mode maintenance : "true" réserve tout l'accès aux admins.
#FT_MOULINETTE_MAINTENANCE=false
# Campus utilisé pour les classements (défaut "Perpignan").
#FT_MOULINETTE_CAMPUS_NAME=Perpignan

# ── Données persistantes ────────────────────────────────────────────────────
# Chemins relatifs par défaut ; en conteneur, pointer sur le volume monté.
#FT_MOULINETTE_TESTS_DIR=tests
#FT_MOULINETTE_HISTORY_DIR=/app/data/history
#FT_MOULINETTE_LOCKS_FILE=/app/data/locked_projects.json
#FT_MOULINETTE_POOL_CACHE=/app/data/pool_cache.json
#FT_MOULINETTE_POOL_HISTORY=/app/data/pool_history.json

# ── SSO inter-services (prod) ───────────────────────────────────────────────
# Secret partagé, STRICTEMENT IDENTIQUE côté ft_intra (openssl rand -hex 32).
# Signe le cookie d'identité partagé entre sous-domaines. Vide = pas de SSO
# (dev mono-service, login OAuth local classique).
#FT_SSO_SECRET=
# Domaine parent du cookie d'identité, pour le partager entre sous-domaines.
#FT_SSO_COOKIE_DOMAIN=.ft-moulinette.fr
# Login délégué à la racine ft_intra : on y renvoie les visiteurs non connectés.
#FT_MOULINETTE_LOGIN_URL=https://ft-moulinette.fr/login