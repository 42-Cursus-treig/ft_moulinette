MOULINETTE_42_CLIENT_ID=
MOULINETTE_42_CLIENT_SECRET=
MOULINETTE_42_REDIRECT_URL=
# Optionnel : base de l'API 42 (défaut https://api.intra.42.fr).
# Utile en dev pour pointer vers un mock local.
#MOULINETTE_42_BASE_URL=
# Scope OAuth demandé à 42 (défaut « public projects »). L'intra dashboard lit
# projets/corrections/défenses et écrit (inscription à un projet, feedback
# correcteur) : il faut « projects ». Ce scope DOIT être coché sur l'app côté
# intra 42, sinon l'autorisation est refusée. Changer ce scope oblige tous les
# utilisateurs à se reconnecter une fois. « public » seul désactive les briques
# 42 du dashboard (mode light).
#MOULINETTE_42_SCOPE=public projects

# Optionnel : adresse d'écoute (défaut :8080). En prod split, mettre :9090
# pour laisser :8080 à ft_intra.
#MOULINETTE_ADDR=:9090

# --- SSO inter-services (prod) ---
# Secret partagé, IDENTIQUE côté ft_intra (openssl rand -hex 32). Signe le
# cookie d'identité qui permet de reconnaître un user connecté sur la racine
# ft_intra. Vide = pas de SSO (dev mono-service, login OAuth local classique).
#MOULINETTE_SESSION_SECRET=
# Domaine parent du cookie d'identité, pour le partager entre sous-domaines.
#MOULINETTE_COOKIE_DOMAIN=.ft-moulinette.fr
# Login délégué à la racine ft_intra : on y renvoie les visiteurs non connectés.
#MOULINETTE_LOGIN_URL=https://ft-moulinette.fr/login
